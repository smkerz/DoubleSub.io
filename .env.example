# Configuration DoubleSub.io
# Copier ce fichier en .env et modifier les valeurs

# Clé secrète pour Flask (CHANGEZ-LA EN PRODUCTION!)
SECRET_KEY=changez-moi-en-production-utilisez-une-cle-aleatoire-longue

# Mode debug (True pour dev, False pour production)
DEBUG=True

# Serveur
HOST=0.0.0.0
PORT=5000

# Chemins FFmpeg (modifier si nécessaire)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
